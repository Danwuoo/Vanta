{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Planner Action Sequence",
  "type": "object",
  "description": "A bounded sequence of Stage 1 action proposals. This is planner output, not verifier output.",
  "required": [
    "actions"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "planner_id": {
      "type": "string"
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "action_type",
          "action_payload"
        ],
        "properties": {
          "action_type": {
            "type": "string",
            "enum": [
              "read_file",
              "list_files",
              "compute_hash",
              "simulate_patch",
              "compute_diff",
              "apply_reversible_patch",
              "record_compensable_action",
              "validate_artifact"
            ]
          },
          "action_payload": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
