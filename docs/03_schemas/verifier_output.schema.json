{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Verifier Output",
  "type": "object",
  "required": [
    "schema_version"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "validity_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "calibration_state": {
      "type": "object"
    },
    "disagreement": {
      "type": "object"
    },
    "risk_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "violated_constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_extra_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "failure_logits": {
      "type": "object"
    },
    "credit_hints": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
