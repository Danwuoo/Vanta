{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Benchmark Task",
  "type": "object",
  "required": [
    "schema_version"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "task_type": {
      "type": "string"
    },
    "prompt": {
      "type": "string"
    },
    "initial_state": {
      "type": "object"
    },
    "allowed_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "success_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "failure_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_logs": {
      "type": "array",
      "description": "Runtime artifacts required for evaluating this task, such as execution steps, evidence packets, verifier outputs, and episode journal entries.",
      "items": {
        "type": "string"
      }
    },
    "side_effect_classes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "READ_ONLY",
          "SIMULATED",
          "REVERSIBLE",
          "COMMITTABLE",
          "IRREVERSIBLE",
          "MEMORY_WRITE"
        ]
      }
    }
  },
  "additionalProperties": false
}
