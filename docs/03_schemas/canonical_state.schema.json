{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Canonical State",
  "type": "object",
  "required": [
    "schema_version"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Version of this schema used by the runtime."
    },
    "state_id": {
      "type": "string"
    },
    "task_intent": {
      "type": "string"
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "uncertainty": {
      "type": "object"
    },
    "provenance": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
