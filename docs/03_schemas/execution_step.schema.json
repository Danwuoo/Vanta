{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Execution Step",
  "type": "object",
  "required": [
    "schema_version"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "step_id": {
      "type": "string"
    },
    "parent_step_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "action_type": {
      "type": "string"
    },
    "action_payload": {
      "type": "object"
    },
    "expected_effect": {
      "type": "string"
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "postconditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependency_edges": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "verifier_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rollback_policy": {
      "type": "string"
    },
    "side_effect_class": {
      "type": "string",
      "enum": [
        "READ_ONLY",
        "SIMULATED",
        "REVERSIBLE",
        "COMMITTABLE",
        "IRREVERSIBLE",
        "MEMORY_WRITE"
      ]
    }
  },
  "additionalProperties": false
}
