{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Execution Step",
  "type": "object",
  "required": [
    "schema_version",
    "step_id",
    "episode_id",
    "action_type",
    "action_payload",
    "expected_effect",
    "preconditions",
    "postconditions",
    "dependency_edges",
    "verifier_requirements",
    "rollback_policy",
    "side_effect_class",
    "status"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "step_id": {
      "type": "string"
    },
    "episode_id": {
      "type": "string"
    },
    "parent_step_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "action_type": {
      "type": "string",
      "enum": [
        "read_file",
        "list_files",
        "compute_hash",
        "simulate_patch",
        "compute_diff",
        "apply_reversible_patch",
        "validate_artifact"
      ]
    },
    "action_payload": {
      "type": "object"
    },
    "expected_effect": {
      "type": "string"
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "postconditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependency_edges": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "verifier_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rollback_policy": {
      "type": "string"
    },
    "side_effect_class": {
      "type": "string",
      "enum": [
        "READ_ONLY",
        "SIMULATED",
        "REVERSIBLE",
        "COMMITTABLE",
        "IRREVERSIBLE",
        "MEMORY_WRITE"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "ready",
        "running",
        "succeeded",
        "failed",
        "rejected",
        "aborted",
        "committed",
        "rolled_back"
      ]
    }
  },
  "additionalProperties": false
}
