{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Evidence Packet",
  "type": "object",
  "required": [
    "schema_version"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "evidence_id": {
      "type": "string"
    },
    "episode_id": {
      "type": "string"
    },
    "step_id": {
      "type": "string"
    },
    "pre_state_summary": {
      "type": "string"
    },
    "action_ref": {
      "type": "string"
    },
    "observation": {
      "type": "object"
    },
    "post_state_summary": {
      "type": "string"
    },
    "verifier_result": {
      "type": "object"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "disagreement": {
      "type": "object"
    },
    "violated_constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "failure_logits": {
      "type": "object"
    },
    "credit_hints": {
      "type": "object"
    },
    "provenance": {
      "type": "object"
    },
    "runtime_context": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
